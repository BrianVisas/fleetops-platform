# Versions of the local cluster's parts, in one place: cluster-up.sh and the
# cluster workflow both read this file, so the Mac and CI cannot drift (EL-019).

# kind's own release notes say to pin node images by digest. Kubernetes 1.37.0,
# the default of kind v0.33.0; the image is multi-arch (arm64 on the Mac).
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# Envoy Gateway's Helm chart, which also installs the Gateway API CRDs (ADR-0008).
ENVOY_GATEWAY_VERSION=v1.10.0

# The CloudNativePG operator, installed from the manifest of its GitHub release.
# The checksum is of that file, so a changed download fails before it is applied.
CNPG_VERSION=1.30.2
CNPG_MANIFEST_SHA256=ea4cc355b394e10661d30c6b409cefb19029dd973bccb76b1ed8c789985bc68c

# Only CI downloads these; on the Mac they come from the Brewfile. The checksums
# are the ones the projects publish for each release.
KIND_VERSION=v0.33.0
KIND_LINUX_AMD64_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
HELM_VERSION=v4.3.2
HELM_LINUX_AMD64_SHA256=d1c0278d46beab79582d7e50f5b3dc206944ba8e577cde618513fd07daa53983
