# Versions of the local cluster's parts, in one place: cluster-up.sh and the
# cluster workflow both read this file, so the Mac and CI cannot drift (EL-019).

# kind's own release notes say to pin node images by digest. Kubernetes 1.37.0,
# the default of kind v0.33.0; the image is multi-arch (arm64 on the Mac).
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# Envoy Gateway's Helm chart, which also installs the Gateway API CRDs (ADR-0008).
ENVOY_GATEWAY_VERSION=v1.10.0

# The CloudNativePG operator 1.30.2, from its Helm chart: cluster-up.sh installs
# it, and Argo CD manages it afterwards from the same chart and values
# (deploy/gitops/apps/cloudnative-pg.yaml, ADR-0010). The checksum is of the
# chart archive in the GitHub release, so a changed download fails before it is
# installed.
CNPG_VERSION=1.30.2
CNPG_CHART_VERSION=0.29.2
CNPG_CHART_SHA256=9df3f074ecaa8af10277ad155899470618ea9a565d7c7c48187bdc7887655960

# Argo CD v3.6.2, from its Helm chart: gitops-bootstrap.sh installs it, and
# Argo CD manages itself afterwards (deploy/gitops/apps/argocd.yaml). Taken on
# release day instead of after the usual 14-day cooldown because v3.6.2 fixes
# CVE-2026-77299; security fixes do not wait (docs/SECURITY_POLICY.md).
ARGOCD_VERSION=v3.6.2
ARGOCD_CHART_VERSION=10.18.2
ARGOCD_CHART_SHA256=6900d104854a18c733616a56853012eb9a136f2256a9d35de73cda03689a59d1

# Only CI downloads these; on the Mac they come from the Brewfile. The checksums
# are the ones the projects publish for each release.
KIND_VERSION=v0.33.0
KIND_LINUX_AMD64_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
HELM_VERSION=v4.3.2
HELM_LINUX_AMD64_SHA256=d1c0278d46beab79582d7e50f5b3dc206944ba8e577cde618513fd07daa53983
